# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173
# Set to true only when deployed behind a reverse proxy/load balancer
# (Render, Railway, Nginx, etc). This makes rate limiting and IP
# logging use the real client IP instead of the proxy's. Leave
# false/unset for local development.
TRUST_PROXY=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
SOCIETY_INVITE_CODE=replace-with-a-code-you-share-with-real-members

# The frontend's origin (no trailing slash). Used to build the links sent
# in verification and password-reset emails, e.g. https://engsociety.rmc-cmr.ca
FRONTEND_URL=http://localhost:5173

# Outgoing email for verification links and password resets. Any SMTP
# provider works — Gmail (with an app password), SendGrid, Mailgun,
# Postmark, AWS SES, or a local dev catcher like Mailhog/Ethereal.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to true only if using port 465 (implicit TLS). Leave false/unset for
# STARTTLS on 587, which is the common case.
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="RMC Engineering Society <no-reply@rmc-cmr.ca>"

# Admin
# Comma-separated emails that get auto-promoted to admin on login/register.
# This is how your first admin gets created — after that, admins can
# promote other registered members from the Admin page in the app.
ADMIN_EMAILS=you@rmc.ca

# Firebase Storage — used for team page photo uploads and dispatch cover
# images. Find the exact bucket name in Firebase Console > Storage (shown
# at the top of the page, e.g. your-project-id.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Firestore credentials — use ONE of the two options below.

# Option A (local development): path to the service account JSON file
# you downloaded from Firebase Console > Project settings > Service accounts.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B (hosting providers without file uploads, e.g. Render/Railway):
# paste the entire service account JSON as a single-line string instead,
# and delete/ignore GOOGLE_APPLICATION_CREDENTIALS above.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
