rules_version = '2';

// This app never talks to Firestore from the browser -- only this
// Express server does, using the Admin SDK, which bypasses these rules
// entirely. Keeping the rules closed means the data is still safe even
// if a Firebase Web SDK config ever leaks or gets added later by mistake.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
